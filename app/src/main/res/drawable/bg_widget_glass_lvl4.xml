<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#D9161F33"
                android:centerColor="#CC0E1525"
                android:endColor="#D90A0F1D" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="90dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
